# Copia este archivo como ".env" y coloca aqui tus credenciales reales.
# El archivo ".env" NUNCA debe subirse al repositorio (ya esta en .gitignore).

DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventario_db
DB_USER=postgres
DB_PASSWORD=coloca_tu_password_aqui

# Clave secreta de Flask (usada para mensajes flash y sesiones)
SECRET_KEY=cambia-esta-clave-por-una-cadena-larga-y-aleatoria
